#!/bin/sh

# Deterministic SSH stand-in used only while recording the README demo.
for argument in "$@"; do
  alias=$argument
done

case "$alias" in
  prod-api-01)
    printf '\033[2J\033[H'
    printf '\033[1;36mConnected to prod-api-01\033[0m (deploy@api-01.prod.northstar.internal)\r\n\r\n'
    while true; do
      printf '\033[1;32mdeploy@prod-api-01\033[0m:\033[1;34m~\033[0m$ '
      IFS= read -r command || exit 0
      case "$command" in
        hostname) printf 'api-01.prod.northstar.internal\r\n' ;;
        exit)
          printf 'logout\r\nConnection to api-01.prod.northstar.internal closed.\r\n'
          exit 0
          ;;
        *) printf '%s: command not found\r\n' "$command" ;;
      esac
    done
    ;;
  dev-shell-01)
    printf '\033[1;36mWelcome to the local development shell\033[0m\r\n'
    printf 'Connected via SSH to devops@shell-01.dev.northstar.internal\r\n\r\n'
    while true; do
      printf '\033[1;32mdevops@dev-shell-01\033[0m:\033[1;34m/srv/northstar/app\033[0m$ '
      IFS= read -r command || exit 0
      case "$command" in
        whoami) printf 'devops\r\n' ;;
        pwd) printf '/srv/northstar/app\r\n' ;;
        exit) printf 'logout\r\n'; exit 0 ;;
        *) printf '%s: command not found\r\n' "$command" ;;
      esac
    done
    ;;
  dr-gateway-01)
    printf 'ssh: connect to host gateway-01.dr.northstar.internal port 2223: Connection refused\n' >&2
    exit 255
    ;;
  *)
    printf 'Connected to %s\r\n' "$alias"
    exit 0
    ;;
esac
